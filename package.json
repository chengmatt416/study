{
  "name": "study",
  "private": true,
  "license": "MIT",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts --strict-vars=false --env-file .dev.vars.example",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "postinstall": "node scripts/copy-pdfjs.mjs",
    "vendor": "node scripts/copy-pdfjs.mjs && bash scripts/vendor-geogebra.sh && bash scripts/vendor-qalculate.sh",
    "openmaic:setup": "node scripts/openmaic-workers.mjs prepare",
    "openmaic:build": "node scripts/openmaic-workers.mjs build",
    "openmaic:test": "node scripts/openmaic-core.mjs test",
    "openmaic:db": "node integrations/openmaic/cloudflare/scripts/prepare-database.mjs",
    "openmaic:connect": "node scripts/openmaic-workers.mjs connect",
    "openmaic:smoke": "node scripts/openmaic-core-smoke.mjs",
    "openmaic:workers:prepare": "node scripts/openmaic-workers.mjs prepare",
    "openmaic:workers:build": "node scripts/openmaic-workers.mjs build",
    "openmaic:workers:test": "node --experimental-transform-types --test integrations/openmaic/cloudflare/test/*.test.mjs",
    "openmaic:deploy": "node scripts/openmaic-workers.mjs deploy",
    "openmaic:workers:deploy": "node scripts/openmaic-workers.mjs deploy",
    "openmaic:workers:connect": "node scripts/openmaic-workers.mjs connect",
    "openmaic:workers:verify": "node scripts/openmaic-workers.mjs verify",
    "openmaic:workers:contract": "vitest run --config integrations/openmaic/cloudflare/vitest.config.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.1",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@modelcontextprotocol/server": "^2.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.104.1",
    "agents": "^0.26.0",
    "canvas-confetti": "^1.9.4",
    "chart.js": "4.5.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "docx-preview": "0.4.1",
    "hono": "^4.13.12",
    "jszip": "^3.10.1",
    "katex": "^0.16.47",
    "lib0": "^0.2.119",
    "mammoth": "^1.13.0",
    "mathjs": "^15.2.0",
    "mathlive": "^0.111.0",
    "motion": "^14.0.0",
    "pdfjs-dist": "^6.4.299",
    "perfect-freehand": "^1.2.3",
    "pptxviewjs": "1.1.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "simple-statistics": "^7.12.1",
    "ts-fsrs": "^5.4.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "uplot": "^1.6.32",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/workers-types": "^5.20261004.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
