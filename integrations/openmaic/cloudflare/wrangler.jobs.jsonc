{
  "name": "study-app-openmaic-jobs",
  "main": "./lib/study-workers/jobs-worker.ts",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "study-app-openmaic-core" }],
  "durable_objects": { "bindings": [{ "name": "OPENMAIC_JOBS", "class_name": "CoreCoordinator" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CoreJobs"] }, { "tag": "v2", "renamed_classes": [{ "from": "CoreJobs", "to": "CoreCoordinator" }] }],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
